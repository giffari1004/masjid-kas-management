# ============================================================
# Environment — Backend API (apps/api)
# File ini JANGAN di-commit (sudah masuk .gitignore)
# ============================================================

# --- Database (Supabase) ---
# Connection Pooling (port 6543) — dipakai aplikasi saat runtime
# Ambil dari: Supabase Dashboard > Project Settings > Database > Connection string > URI
# Ganti [PROJECT-REF], [REGION], dan [PASSWORD] sesuai project Anda.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct Connection (port 5432) — dipakai Prisma CLI untuk migration & seed
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Auth (diisi saat fitur login dikerjakan) ---
JWT_SECRET="change-me-to-a-long-random-string"
